# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Sync all dependencies (dev + docs + gpu extras)
sync:
    uv sync --all-extras --dev

# Install pre-commit hooks
hooks:
    uv run pre-commit install --install-hooks

# Update dependencies
update:
    uv sync --upgrade

# Remove caches and build artifacts
clean:
    rm -rf .pytest_cache .mypy_cache .ruff_cache build dist *.egg-info htmlcov .coverage
    find . -path ./.venv -prune -o -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
